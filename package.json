{
  "name": "dsh-desktop",
  "version": "1.1.4",
  "description": "A Windows desktop host for DeepSeek Harness.",
  "main": "electron/main.cjs",
  "author": "DSH Desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "test": "node --test test/*.test.cjs",
    "electron:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-electron-runtime.ps1",
    "runtime:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-node-runtime.ps1",
    "runtime:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-harness-runtime.ps1",
    "validate:third-party-plugin": "node scripts/validate-third-party-plugin.cjs",
    "validate:controlled-plugin-install": "node scripts/validate-controlled-plugin-install.cjs",
    "release:governance": "node scripts/release-governance.cjs",
    "smoke:packaged-terminal": "node scripts/smoke-packaged-terminal.cjs",
    "pack:win": "vendor\\runtime\\win32-x64\\node.exe node_modules\\electron-builder\\out\\cli\\cli.js --dir --win --x64",
    "dist:win": "vendor\\runtime\\win32-x64\\node.exe node_modules\\electron-builder\\out\\cli\\cli.js --win nsis portable --x64"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.8.1",
    "harness-build-pnpm": "npm:pnpm@11.7.0",
    "pnpm": "11.19.0"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": true,
    "npmRebuild": false,
    "compression": "store",
    "electronDist": "build/electron-v43.4.1-win32-x64.zip",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "harness-status.html",
      "assets/harness-status.css",
      "assets/harness-status.js",
      "assets/workbench-panel.css",
      "assets/workbench-panel.js",
      "workbench-dock.html",
      "assets/workbench-dock.js",
      "assets/workbench-dock.css",
      "assets/docked-surfaces.css",
      "assets/workbench-native-layout.css",
      "terminal.html",
      "assets/terminal-window.css",
      "assets/terminal-window.js",
      "context-sources.html",
      "assets/context-sources.css",
      "assets/context-sources.js",
      "plugin-health.html",
      "assets/plugin-health.css",
      "assets/plugin-health.js",
      "office-center.html",
      "assets/office-center.css",
      "assets/office-center.js",
      "wiki-center.html",
      "assets/wiki-center.css",
      "assets/wiki-center.js",
      "worktrees.html",
      "assets/worktrees.css",
      "assets/worktrees.js",
      "git-delivery.html",
      "assets/git-delivery.css",
      "assets/git-delivery.js",
      "build/icon.ico",
      "tasks-subagents.html",
      "assets/tasks-subagents.css",
      "assets/tasks-subagents.js",
      "assets/background-tasks.js",
      "assets/workbench-files.css",
      "assets/workbench-files.js",
      "assets/workbench-preview.css",
      "assets/workbench-preview.js",
      "assets/workbench-command.css",
      "assets/workbench-command.js",
      "assets/workbench-checkpoint.css",
      "assets/workbench-checkpoint.js",
      "assets/workbench-network.css",
      "assets/workbench-network.js",
      "assets/harness-localization.js",
      "assets/document-intake.js",
      "assets/session-continuity.js",
      "assets/composer-text-bridge.js",
      "assets/document-intake.css",
      "electron/extension-center.cjs",
      "electron/side-chat.cjs",
      "electron/side-chat-preload.cjs",
      "node_modules/@xterm/xterm/lib/xterm.js",
      "node_modules/@xterm/xterm/css/xterm.css",
      "node_modules/@xterm/xterm/LICENSE",
      "node_modules/@xterm/addon-fit/lib/addon-fit.js",
      "node_modules/@xterm/addon-fit/LICENSE",
      "!node_modules/node-pty/**/*",
      "!node_modules/node-addon-api/**/*",
      "!node_modules/@xterm/xterm/src/**/*",
      "!node_modules/@xterm/xterm/lib/*.map",
      "!node_modules/@xterm/xterm/lib/*.mjs",
      "!node_modules/@xterm/addon-fit/src/**/*",
      "!node_modules/@xterm/addon-fit/lib/*.map",
      "!node_modules/@xterm/addon-fit/lib/*.mjs",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/runtime/win32-x64",
        "to": "runtime",
        "filter": [
          "node.exe",
          "LICENSE",
          "README.md"
        ]
      },
      {
        "from": "vendor/harness-hoisted-0.1.2-alpha.5/node_modules",
        "to": "harness/node_modules"
      },
      {
        "from": "vendor/harness-hoisted-0.1.2-alpha.5/harness-runtime.json",
        "to": "harness/harness-runtime.json"
      },
      {
        "from": "electron/terminal-pty-host.cjs",
        "to": "terminal/terminal-pty-host.cjs"
      },
      {
        "from": "node_modules/pnpm",
        "to": "pnpm/package",
        "filter": [
          "bin/**/*",
          "dist/**/*",
          "package.json",
          "LICENSE"
        ]
      },
      {
        "from": "build/pnpm",
        "to": "pnpm",
        "filter": [
          "pnpm.cmd",
          "empty.npmrc"
        ]
      },
      {
        "from": "node_modules/node-pty",
        "to": "terminal/node_modules/node-pty",
        "filter": [
          "lib/**/*",
          "prebuilds/win32-x64/*.node",
          "prebuilds/win32-x64/conpty/**/*",
          "package.json",
          "LICENSE",
          "!**/*.pdb"
        ]
      },
      {
        "from": "config/dsh-desktop.patch.yml",
        "to": "harness-config/dsh-desktop.patch.yml"
      },
      {
        "from": "runtime/dsh-desktop-shell-env",
        "to": "harness-plugins/dsh-desktop-shell-env",
        "filter": [
          "index.mjs",
          "package.json"
        ]
      },
      {
        "from": "runtime/dsh-desktop-credentials",
        "to": "harness-plugins/dsh-desktop-credentials",
        "filter": ["index.mjs", "package.json"]
      },
      {
        "from": "runtime/dsh-desktop-tools",
        "to": "harness-plugins/dsh-desktop-tools",
        "filter": ["index.mjs", "session-control.mjs", "package.json"]
      },
      {
        "from": "resources/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DSH-Desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": false
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.2.0-beta.15"
  }
}
